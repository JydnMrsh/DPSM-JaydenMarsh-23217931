<Window x:Class="Phase_2_Warehouse_Management_System.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bunnings IMS" Height="300" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <StackPanel VerticalAlignment="Center" Margin="40">
        <Button x:Name="BtnGUI" Content="GUI"
                Height="44" Margin="0,0,0,12"
                Click="BtnGUI_Click"/>
        <Button x:Name="BtnConsole" Content="Run Console Demo"
                Height="44"
                Click="BtnConsole_Click"/>
    </StackPanel>
</Window>
