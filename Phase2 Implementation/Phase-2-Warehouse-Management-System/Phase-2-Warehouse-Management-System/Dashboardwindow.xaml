<Window x:Class="Phase_2_Warehouse_Management_System.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bunnings IMS — Dashboard"
        Height="700" Width="1000"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Top navbar ── -->
        <Border Grid.Row="0" Background="#FF1C5361">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BUNNINGS Inventory Management System" FontFamily="Segoe UI" FontSize="15"
                               FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- User info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtNavUser" FontFamily="Segoe UI" FontSize="13"
                               Foreground="White" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Logout -->
                <Button Grid.Column="2" Content="Logout"
                        Style="{StaticResource DangerButton}"
                        Padding="14,6" VerticalAlignment="Center"
                        Click="BtnLogout_Click"/>
            </Grid>
        </Border>

        <!-- ── Main content ── -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left sidebar: permissions panel ── -->
            <Border Grid.Column="0" Style="{StaticResource Card}"
                    Margin="0,0,12,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="MY PERMISSIONS" Style="{StaticResource SectionHeader}"
                               FontSize="11" Margin="0,0,0,12"/>

                    <ItemsControl x:Name="PermissionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Text="{Binding Icon}" FontSize="13" Width="22"/>
                                    <TextBlock Text="{Binding Label}" FontFamily="Segoe UI"
                                               FontSize="12" Foreground="{Binding Colour}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Margin="0,14"/>

                    <TextBlock Text="QUICK DEMO USERS" Style="{StaticResource SectionHeader}"
                               FontSize="11" Margin="0,0,0,8"/>
                    <TextBlock Text="dave_w / pass123" FontFamily="Consolas" FontSize="10"
                               Foreground="#4A5568" Margin="0,1"/>
                    <TextBlock Text="sarah_r / pass456" FontFamily="Consolas" FontSize="10"
                               Foreground="#4A5568" Margin="0,1"/>
                    <TextBlock Text="mgr_jane / mgr789" FontFamily="Consolas" FontSize="10"
                               Foreground="#4A5568" Margin="0,1"/>
                    <TextBlock Text="mgr_tom / mgr000" FontFamily="Consolas" FontSize="10"
                               Foreground="#4A5568" Margin="0,1"/>
                    <TextBlock Text="it_admin / admin999" FontFamily="Consolas" FontSize="10"
                               Foreground="#4A5568" Margin="0,1"/>
                </StackPanel>
            </Border>

            <!-- ── Right content: tab panels ── -->
            <TabControl Grid.Column="1" x:Name="MainTabs"
                        Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="FontFamily"  Value="Segoe UI"/>
                        <Setter Property="FontSize"    Value="13"/>
                        <Setter Property="Padding"     Value="14,8"/>
                        <Setter Property="Background"  Value="Transparent"/>
                        <Setter Property="Foreground"  Value="#4A5568"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#1F4E79"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <!--   TAB 1: Stock Overview   -->
                <TabItem Header="Stock Overview">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Current Stock Levels"
                                       Style="{StaticResource SectionHeader}"/>

                            <DataGrid Grid.Row="1" x:Name="StockGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F8FAFC"
                                      BorderThickness="1" BorderBrush="#D0D7E2"
                                      FontFamily="Segoe UI" FontSize="13"
                                      CanUserResizeRows="False"
                                      SelectionMode="Single"
                                      Margin="0,0,0,12">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background"   Value="#EBF3FB"/>
                                        <Setter Property="Foreground"   Value="Black"/>
                                        <Setter Property="FontWeight"   Value="SemiBold"/>
                                        <Setter Property="Padding"      Value="10,8"/>
                                        <Setter Property="FontFamily"   Value="Segoe UI"/>
                                        <Setter Property="FontSize"     Value="12"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"        Binding="{Binding ItemId}"       Width="50"/>
                                    <DataGridTextColumn Header="Item Name" Binding="{Binding Name}"         Width="*"/>
                                    <DataGridTextColumn Header="Price"     Binding="{Binding PriceDisplay}" Width="80"/>
                                    <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseStock}" Width="90"/>
                                    <DataGridTextColumn Header="Retail"    Binding="{Binding RetailStock}"  Width="80"/>
                                    <DataGridTextColumn Header="Total"     Binding="{Binding TotalStock}"   Width="70"/>
                                    <DataGridTextColumn Header="Location"  Binding="{Binding Location}"     Width="100"/>
                                    <DataGridTextColumn Header="Status"    Binding="{Binding StockStatus}"  Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="LOW STOCK">
                                                        <Setter Property="Foreground" Value="#C0392B"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="OK">
                                                        <Setter Property="Foreground" Value="#1E7E34"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Grid.Row="2" Content="↻  Refresh" HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnRefreshStock_Click"/>
                        </Grid>
                    </Border>
                </TabItem>

                <!--   TAB 2: Update Stock   -->
                <TabItem Header="Update Stock" x:Name="TabUpdateStock">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="Update Stock Level"
                                       Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Add or remove stock in warehouse or retail."
                                       FontFamily="Segoe UI" FontSize="12" Foreground="#4A5568"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="SELECT ITEM" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="CboUpdateItem" Margin="0,0,0,14" Height="34"/>

                            <TextBlock Text="LOCATION" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="CboUpdateLocation" Margin="0,0,0,14" Height="34">
                                <ComboBoxItem Content="Warehouse" IsSelected="True"/>
                                <ComboBoxItem Content="Retail"/>
                            </ComboBox>

                            <TextBlock Text="QUANTITY (use negative to remove)"
                                       Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtUpdateQty" Style="{StaticResource TextInput}"
                                     Margin="0,0,0,20" Text="10"/>

                            <Button Content="Update Stock" Style="{StaticResource PrimaryButton}"
                                    Height="38" Click="BtnUpdateStock_Click"/>

                            <TextBlock x:Name="TxtUpdateResult" FontFamily="Segoe UI" FontSize="12"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!--   TAB 3: Transfer Stock   -->
                <TabItem Header="Transfer" x:Name="TabTransfer">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="Transfer Stock Between Departments"
                                       Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="Move stock between the warehouse and retail floor."
                                       FontFamily="Segoe UI" FontSize="12" Foreground="#4A5568"
                                       Margin="0,0,0,16"/>

                            <TextBlock Text="SELECT ITEM" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="CboTransferItem" Margin="0,0,0,14" Height="34"/>

                            <TextBlock Text="DIRECTION" Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="CboTransferDirection" Margin="0,0,0,14" Height="34">
                                <ComboBoxItem Content="Warehouse to Retail" IsSelected="True"/>
                                <ComboBoxItem Content="Retail to Warehouse"/>
                            </ComboBox>

                            <TextBlock Text="QUANTITY" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtTransferQty" Style="{StaticResource TextInput}"
                                     Margin="0,0,0,20" Text="5"/>

                            <Button Content="Transfer Stock" Style="{StaticResource PrimaryButton}"
                                    Height="38" Click="BtnTransfer_Click"/>

                            <TextBlock x:Name="TxtTransferResult" FontFamily="Segoe UI" FontSize="12"
                                       Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!--   TAB 4: Order Requests   -->
                <TabItem Header="Orders" x:Name="TabOrders" GotFocus="TabOrders_GotFocus">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Order Requests"
                                       Style="{StaticResource SectionHeader}"/>

                            <!-- Generate order (Warehouse only) -->
                            <Border Grid.Row="1" x:Name="PanelGenerateOrder"
                                    Background="#EBF3FB" CornerRadius="6"
                                    Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="ITEM" Style="{StaticResource FormLabel}"/>
                                        <ComboBox x:Name="CboOrderItem" Height="50"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="QUANTITY" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtOrderQty" Style="{StaticResource TextInput}"
                                                 Height="50" Text="20"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,10,0">
                                        <Button Content="Generate Order"
                                                Style="{StaticResource PrimaryButton}"
                                                Height="34" Click="BtnGenerateOrder_Click"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="TxtOrderResult" FontFamily="Segoe UI"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   MaxWidth="150" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Pending orders list (Manager only) -->
                            <StackPanel Grid.Row="2" x:Name="PanelPendingOrders">
                                <TextBlock Text="PENDING ORDERS" Style="{StaticResource FormLabel}"
                                           Margin="0,0,0,8"/>
                                <DataGrid x:Name="OrdersGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          RowBackground="White"
                                          AlternatingRowBackground="#F8FAFC"
                                          BorderThickness="1" BorderBrush="#D0D7E2"
                                          FontFamily="Segoe UI" FontSize="13"
                                          CanUserResizeRows="False"
                                          SelectionMode="Single"
                                          Height="200"
                                          Margin="0,0,0,12">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#EBF3FB"/>
                                            <Setter Property="Foreground" Value="#FF101010"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding"   Value="10,8"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="FontSize"  Value="12"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order #"   Binding="{Binding RequestId}"  Width="70"/>
                                        <DataGridTextColumn Header="Item"      Binding="{Binding ItemName}"   Width="*"/>
                                        <DataGridTextColumn Header="Qty"       Binding="{Binding Quantity}"   Width="60"/>
                                        <DataGridTextColumn Header="Requested By" Binding="{Binding RequestedBy}" Width="120"/>
                                        <DataGridTextColumn Header="Status"    Binding="{Binding Status}"     Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" x:Name="PanelManagerActions">
                                    <Button Content="Approve Selected"
                                            Style="{StaticResource SuccessButton}"
                                            Margin="0,0,10,0" Click="BtnApprove_Click"/>
                                    <Button Content="Reject Selected"
                                            Style="{StaticResource DangerButton}"
                                            Click="BtnReject_Click"/>
                                    <TextBlock x:Name="TxtApproveResult"
                                               FontFamily="Segoe UI" FontSize="12"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </Border>
                </TabItem>

                <!--   TAB 5: IT Admin   -->
                <TabItem Header="IT Admin" x:Name="TabIT">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                        <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                            <TextBlock Text="IT Administration"
                                       Style="{StaticResource SectionHeader}"/>

                            <TextBlock Text="SIMULATE CREATING A USER"
                                       Style="{StaticResource FormLabel}" Margin="0,8,0,4"/>
                            <Border Background="#EBF3FB" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="USERNAME" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtNewUsername" Style="{StaticResource TextInput}"
                                                 Text="new_user"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="ROLE" Style="{StaticResource FormLabel}"/>
                                        <ComboBox x:Name="CboNewRole" Height="34">
                                            <ComboBoxItem Content="WarehouseStaff" IsSelected="True"/>
                                            <ComboBoxItem Content="RetailStaff"/>
                                            <ComboBoxItem Content="StoreManager"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button Content="Create" Style="{StaticResource PrimaryButton}"
                                                Height="34" Click="BtnCreateUser_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="PERMISSION STRATEGY VIEWER"
                                       Style="{StaticResource FormLabel}" Margin="0,0,0,8"/>
                            <Border Background="#F8FAFC" CornerRadius="6"
                                    BorderBrush="#D0D7E2" BorderThickness="1" Padding="14">
                                <ItemsControl x:Name="StrategyViewer">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Role}"
                                                           FontFamily="Segoe UI" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#1F4E79"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Perms}"
                                                           FontFamily="Consolas" FontSize="11"
                                                           Foreground="#4A5568" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock x:Name="TxtITResult" FontFamily="Segoe UI" FontSize="12"
                                       Margin="0,12,0,0" Foreground="#1E7E34"/>
                        </StackPanel>
                    </Border>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
