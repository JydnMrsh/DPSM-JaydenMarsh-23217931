<Application x:Class="BunningsWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>

        <!-- Colours -->
        <SolidColorBrush x:Key="BrandBlue"      Color="#FF104763"/>
        <SolidColorBrush x:Key="BrandLightBlue" Color="#FFB5B5B5"/>
        <SolidColorBrush x:Key="BrandOrange"    Color="#D04F00"/>
        <SolidColorBrush x:Key="SurfaceGrey"    Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BorderGrey"     Color="#D0D7E2"/>
        <SolidColorBrush x:Key="TextDark"       Color="#FF1D1D1D"/>
        <SolidColorBrush x:Key="TextMid"        Color="#FF545454"/>
        <SolidColorBrush x:Key="AlertRed"       Color="#C0392B"/>
        <SolidColorBrush x:Key="SuccessGreen"   Color="#1E7E34"/>
        <SolidColorBrush x:Key="WarningAmber"   Color="#B7791F"/>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF316186"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF949494"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B0BEC5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger/logout button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#C0392B"/>
        </Style>

        <!-- Secondary/outline button -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#2E75B6"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush"     Value="#2E75B6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF3FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success button -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#1E7E34"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#155724"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card panel -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="CornerRadius"     Value="0"/>
            <Setter Property="Padding"          Value="20"/>
            <Setter Property="BorderBrush"      Value="#D0D7E2"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Color="#CCCCCC" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section header label -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="15"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#FF949494"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
        </Style>

        <!-- Form label -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Text input -->
        <Style x:Key="TextInput" TargetType="TextBox">
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Padding"          Value="10,7"/>
            <Setter Property="BorderBrush"      Value="#D0D7E2"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Background"       Value="White"/>
            <Setter Property="Foreground"       Value="#FF272727"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Password input -->
        <Style x:Key="PasswordInput" TargetType="PasswordBox">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="10,7"/>
            <Setter Property="BorderBrush"     Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#1A2B3C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="BorderBrush"     Value="#D0D7E2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="White"/>
        </Style>

    </Application.Resources>
</Application>

